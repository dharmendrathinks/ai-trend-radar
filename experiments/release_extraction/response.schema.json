      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 180},
          "developer_value": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_quotes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 5, "maxLength": 1000}},
          "caveats": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
