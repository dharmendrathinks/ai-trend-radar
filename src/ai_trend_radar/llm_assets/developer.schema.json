          "primary_evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "change_kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "what_changed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "who_should_care": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "practical_difference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 750
          },
          "evidence_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "evidence_quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
